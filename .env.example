# Copy to .env locally or export these variables in your shell.
# Never commit real API keys.

# DeepSeek (https://api.deepseek.com) -- OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# MiniMax (https://api.minimax.chat) -- OpenAI-compatible.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Which provider the harness talks to when more than one key is set.
# Leave it empty and the first provider with a key wins.
MODEL_PROVIDER=
