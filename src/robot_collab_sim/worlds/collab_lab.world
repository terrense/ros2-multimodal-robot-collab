<?xml version="1.0"?>
<sdf version="1.6">
  <world name="collab_lab">
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Ground truth for debugging: /gazebo/model_states publishes真实位姿，
         用于区分"里程计漂了"和"SLAM 错了"。 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="tool_shelf_marker">
      <pose>1.25 -0.75 0.15 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.45 0.35 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.42 0.8 1</ambient>
            <diffuse>0.1 0.42 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.45 0.35 0.30</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="station_a_marker">
      <pose>3.20 0.40 0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.55 0.28 1</ambient>
            <diffuse>0.0 0.55 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="station_b_marker">
      <pose>4.15 -1.10 0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.78 0.35 0.05 1</ambient>
            <diffuse>0.78 0.35 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="handover_zone_marker">
      <pose>2.10 1.35 0.03 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.55 0.55 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.12 0.52 1</ambient>
            <diffuse>0.65 0.12 0.52 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="workbench_obstacle">
      <pose>2.65 -0.55 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.80 0.28 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.48 1</ambient>
            <diffuse>0.45 0.45 0.48 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.80 0.28 0.50</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Visual features for camera-based odometry.
         A RealSense-style pipeline needs texture; the markers alone leave the
         view nearly uniform, which gives ORB detectors zero keypoints. These
         crates are deliberately off the navigation corridor (|y| >= 1.1) and
         static, so they enrich the image without becoming obstacles. -->
    <model name="feature_crate_a">
      <pose>0.80 1.30 0.20 0 0 0.3</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="feature_crate_b">
      <pose>1.40 1.45 0.25 0 0 -0.2</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.5 0.3 0.5</size></box></geometry><material><ambient>0.15 0.65 0.2 1</ambient><diffuse>0.15 0.65 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="feature_crate_c">
      <pose>2.10 1.55 0.15 0 0 0.5</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.4 0.3</size></box></geometry><material><ambient>0.15 0.25 0.85 1</ambient><diffuse>0.15 0.25 0.85 1</diffuse></material></visual></link>
    </model>
    <model name="feature_crate_d">
      <pose>2.90 1.40 0.22 0 0 -0.4</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.35 0.35 0.45</size></box></geometry><material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="feature_crate_e">
      <pose>3.70 1.30 0.20 0 0 0.15</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.45 0.3 0.4</size></box></geometry><material><ambient>0.7 0.2 0.75 1</ambient><diffuse>0.7 0.2 0.75 1</diffuse></material></visual></link>
    </model>
    <model name="feature_crate_f">
      <pose>0.90 -1.35 0.18 0 0 -0.25</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.35 0.45 0.35</size></box></geometry><material><ambient>0.1 0.7 0.75 1</ambient><diffuse>0.1 0.7 0.75 1</diffuse></material></visual></link>
    </model>
    <model name="feature_crate_g">
      <pose>1.70 -1.50 0.25 0 0 0.35</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.5 0.35 0.5</size></box></geometry><material><ambient>0.85 0.45 0.1 1</ambient><diffuse>0.85 0.45 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="feature_crate_h">
      <pose>2.50 -1.40 0.16 0 0 -0.5</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.32</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="feature_crate_i">
      <pose>3.30 -1.55 0.22 0 0 0.2</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.4 0.4 0.44</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link>
    </model>
    <model name="feature_wall">
      <pose>4.60 0.0 0.80 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 6.0 1.6</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>0.2 6.0 1.6</size></box></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
