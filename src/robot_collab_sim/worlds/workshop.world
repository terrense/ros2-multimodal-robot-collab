          <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="screwdriver_shaft">
      <pose>2.15 2.31 0.44 0 0 1.1</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.004</radius><length>0.13</length></cylinder></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="workshop_overhead_camera">
      <!-- Over the workcell, looking down at the mobile base and the three
           official arms. It used to face the east wall, so the one camera that
           could show the whole scene showed a poster instead. -->
      <pose>2.0 0 7.0 0 1.25 3.1416</pose>
      <static>true</static>
      <link name="camera_link">
        <visual name="body">
          <geometry><box><size>0.12 0.10 0.10</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="overhead_camera" type="camera">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.9</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>30.0</far></clip>
          </camera>
          <plugin name="overhead_camera_controller" filename="libgazebo_ros_camera.so">
            <ros><namespace>/</namespace></ros>
            <camera_name>workshop/overhead</camera_name>
            <frame_name>overhead_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
