<?xml version="1.0"?>
<sdf version="1.8">
  <world name="collab_lab">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Ground truth for debugging: /gazebo/model_states publishes真实位姿，
         用于区分"里程计漂了"和"SLAM 错了"。 -->
    <!-- gz-sim publishes the world's state itself; the Classic state plugin
         has no counterpart here. The ROS side gets the model states from
         the bridged world-state topic.

         The sensors system is what renders the cameras and the lidars. In
         Gazebo Classic the camera plugin brought its own sensor with it;
         in gz-sim the sensor is a system of the world, and a world without
         it advertises the camera's topics and never publishes a frame. -->
    <plugin filename="ignition-gazebo6-sensors-system"
            name="gz::sim::systems::Sensors">
    </plugin>
    <!-- The user-commands system is what provides the world's create
         service: without it the robot cannot be spawned into the world at
         all. -->
    <plugin filename="ignition-gazebo6-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- This workspace's own floor. Gazebo's stock one has a contact
         stiffness the solver cannot carry under a wheeled robot whose wheel
         velocities are imposed every step. -->
    <include>
      <uri>/mnt/d/study_claudecode/ros2-multimodal-robot-collab-main/install/robot_collab_sim/share/robot_collab_sim/models/ground_plane</uri>
    </include>
    <!-- The sun, inline. gz-sim has no `model://sun` to find without the
         fuel models, and a workcell without a light is a workcell the
         cameras cannot see anything in. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- The stations are markers, not furniture: they say where the robot
         has to stand, and the robot has to be able to stand there. The
         shelf marker used to have a collision, and the base pushed against
         it and never arrived: the navigation reported a drive that could
         not finish, and every measurement that needed the robot at the
         shelf failed for a reason that had nothing to do with the fault
         under test. -->
    <model name="tool_shelf_marker">
      <pose>1.25 -0.75 0.19 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.45 0.35 0.38</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.42 0.8 1</ambient>
            <diffuse>0.1 0.42 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The tool itself. The marker above says where the shelf is; it has
         no collision, so the depth camera cannot see it and a detector that
         looks at the world finds nothing there. This is the thing on the
         shelf: small, solid, and visible to a depth camera from the other
         side of the lab. -->
    <model name="tool_hex_key_3mm">
      <pose>1.25 -0.75 0.41 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <!-- No collision. The depth camera renders what it can see, so the
             tool is in the cloud whether or not it can be pushed. A
             collision would make it a wall the base's own arm runs into
             when it stops at the shelf. -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.08 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.65 0.15 1</ambient>
            <diffuse>0.85 0.65 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="station_a_marker">
      <pose>3.20 0.40 0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.55 0.28 1</ambient>
            <diffuse>0.0 0.55 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="station_b_marker">
      <pose>4.15 -1.10 0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.78 0.35 0.05 1</ambient>
            <diffuse>0.78 0.35 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="handover_zone_marker">
      <pose>2.10 1.35 0.03 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.55 0.55 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.12 0.52 1</ambient>
            <diffuse>0.65 0.12 0.52 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="workbench_obstacle">
      <pose>2.65 -0.55 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.80 0.28 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.48 1</ambient>
            <diffuse>0.45 0.45 0.48 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.80 0.28 0.50</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Visual features for camera-based odometry.
         A RealSense-style pipeline needs texture; the markers alone leave the
         view nearly uniform, which gives ORB detectors zero keypoints. These
         crates are deliberately off the navigation corridor (|y| >= 1.1) and
         static, so they enrich the image without becoming obstacles. -->
    <model name="feature_crate_a">
      <pose>0.80 1.30 0.20 0 0 0.3</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision></link>
    </model>
    <model name="feature_crate_b">
      <pose>1.40 1.45 0.25 0 0 -0.2</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.5 0.3 0.5</size></box></geometry><material><ambient>0.15 0.65 0.2 1</ambient><diffuse>0.15 0.65 0.2 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.5 0.3 0.5</size></box></geometry></collision></link>
    </model>
    <model name="feature_crate_c">
      <pose>2.10 1.55 0.15 0 0 0.5</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.4 0.3</size></box></geometry><material><ambient>0.15 0.25 0.85 1</ambient><diffuse>0.15 0.25 0.85 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.4 0.3</size></box></geometry></collision></link>
    </model>
    <model name="feature_crate_d">
      <pose>2.90 1.40 0.22 0 0 -0.4</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.35 0.35 0.45</size></box></geometry><material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.35 0.35 0.45</size></box></geometry></collision></link>
    </model>
    <model name="feature_crate_e">
      <pose>3.70 1.30 0.20 0 0 0.15</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.45 0.3 0.4</size></box></geometry><material><ambient>0.7 0.2 0.75 1</ambient><diffuse>0.7 0.2 0.75 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.45 0.3 0.4</size></box></geometry></collision></link>
    </model>
    <model name="feature_crate_f">
      <pose>0.90 -1.35 0.18 0 0 -0.25</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.35 0.45 0.35</size></box></geometry><material><ambient>0.1 0.7 0.75 1</ambient><diffuse>0.1 0.7 0.75 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.35 0.45 0.35</size></box></geometry></collision></link>
    </model>
    <model name="feature_crate_g">
      <pose>1.70 -1.50 0.25 0 0 0.35</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.5 0.35 0.5</size></box></geometry><material><ambient>0.85 0.45 0.1 1</ambient><diffuse>0.85 0.45 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.5 0.35 0.5</size></box></geometry></collision></link>
    </model>
    <model name="feature_crate_h">
      <pose>2.50 -1.40 0.16 0 0 -0.5</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.32</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.32</size></box></geometry></collision></link>
    </model>
    <model name="feature_crate_i">
      <pose>3.30 -1.55 0.22 0 0 0.2</pose>
      <static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>0.4 0.4 0.44</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.4 0.4 0.44</size></box></geometry></collision></link>
    </model>
    <model name="feature_wall">
      <pose>4.60 0.0 0.80 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 6.0 1.6</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>0.2 6.0 1.6</size></box></geometry></collision>
      </link>
    </model>
  <model name='collab_mobile_base'>
    <plugin filename="ignition-gazebo6-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <topic>/world/collab_lab/model/collab_mobile_base/cmd_vel</topic>
      <odom_topic>/world/collab_lab/model/collab_mobile_base/odom</odom_topic>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.72</wheel_separation>
      <wheel_radius>0.06</wheel_radius>
      <frame_id>odom</frame_id>
      <odom_frame_id>odom</odom_frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>

