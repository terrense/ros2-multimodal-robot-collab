<?xml version="1.0"?>
<!-- gz-sim wants a model.config next to the model's SDF; Gazebo Classic
     does not. This is the gz-sim floor: the Classic one carries its
     contact parameters for ODE, this one carries them for bullet. -->
<model>
  <name>ground_plane</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
</model>
