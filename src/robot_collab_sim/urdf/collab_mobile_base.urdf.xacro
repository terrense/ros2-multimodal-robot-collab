<?xml version="1.0"?>
<robot name="collab_mobile_base" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.80"/>
  <xacro:property name="base_width" value="0.62"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_y" value="0.36"/>
  <xacro:property name="wheel_x" value="0.0"/>

  <link name="base_footprint"/>

  <!-- The chassis sits 110 mm above the ground, so that the wheels and not
       the caster carry the robot. -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="30.0"/>
      <inertia ixx="0.90" ixy="0.0" ixz="0.0" iyy="1.60" iyz="0.0" izz="2.00"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="collab_blue">
        <color rgba="0.1 0.34 0.72 1.0"/>
      </material>
    </visual>
    <!-- The chassis's collision is a spine between the wheels, not a belly
         down to the ground.

         A belly that reaches the ground squashes the wheels against it: the
         wheels cannot turn, the odometry never moves, and the navigation
         reports a drive that never happened. A belly that stops above the
         ground lets the wheels carry the robot, which is what a real robot
         does, but a wheel that is commanded to turn while it pushes on the
         floor is the one constraint the solver cannot satisfy, and the
         physics ends up with NaN velocities.

         The spine takes the weight and leaves the wheels free to turn. The
         base still does not drive: the wheels have no load, so they have no
         grip. That is a known defect, and the simulator's own model states
         show it: the odometry says the base moved and the chassis says
         otherwise. -->
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.70 0.60 ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel_link">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.7"/>
        <inertia ixx="0.0016" ixy="0.0" ixz="0.0" iyy="0.0016" iyz="0.0" izz="0.0024"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_dark">
          <color rgba="0.03 0.03 0.035 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${wheel_x} ${y} -0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- Friction, so the wheels grip. -->
      <dynamics damping="0.01" friction="1.2"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left" y="${wheel_y}"/>
  <xacro:wheel name="right" y="${-wheel_y}"/>

  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <material name="caster_gray">
        <color rgba="0.45 0.45 0.48 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
  </link>
  <!-- The caster is up out of the way: it is there to stop the robot from
       tipping, not to carry it. A caster that touches the ground takes the
       weight off the wheels, and wheels with no load on them have no
       grip. -->
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.34 0 -0.07" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.045"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.02 0.02 0.025 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.045"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.30 0 0.16" rpy="0 0 0"/>
  </joint>

  <!-- Intel RealSense D435: official description (mesh + frames) from
       realsense2_description. It creates camera_link, camera_color_*,
       camera_depth_* and the optical frames. -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
  <xacro:sensor_d435 parent="base_link" name="camera">
    <origin xyz="0.38 0 0.10" rpy="0 0 0"/>
  </xacro:sensor_d435>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find robot_collab_sim)/config/ros2_control.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- The wheels are commanded through ros2_control, so the base really
       moves. See config/ros2_control.yaml. -->
  <ros2_control name="MobileBaseSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <xacro:macro name="wheel_command" params="name">
      <joint name="${name}_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="position"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_command name="left"/>
    <xacro:wheel_command name="right"/>
  </ros2_control>

  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <!-- Intel RealSense D435 stand-in: RGB-D with the D435 depth field of view.
         The plugin publishes /camera/color/image_raw, /camera/depth/image_raw,
         /camera/depth/points and the matching camera_info topics. -->
    <sensor name="front_rgbd_camera" type="depth">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="front_rgbd_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <!-- D435 topic layout, matching RealSense's ROS 2 wrapper. -->
          <remapping>camera/image_raw:=camera/color/image_raw</remapping>
          <remapping>camera/camera_info:=camera/color/camera_info</remapping>
          <remapping>camera/points:=camera/depth/points</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Velodyne VLP-16: official description with its gazebo plugin. CPU ray
       (gpu=false) so it runs under WSL without GPU rendering; 720 azimuth
       samples is half the real resolution and enough for LIO-style mapping. -->
  <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
  <xacro:VLP-16 parent="base_link" name="velodyne" topic="/velodyne_points"
                hz="10" samples="720" gpu="false" min_range="0.3" max_range="50.0">
    <origin xyz="-0.15 0 0.34" rpy="0 0 0"/>
  </xacro:VLP-16>

  <gazebo reference="imu_link">
    <sensor name="base_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- Dobot CR10 mounted on the chassis (generated by scripts/mount_dobot.py). -->
  <xacro:include filename="$(find robot_collab_sim)/urdf/dobot_mounted.urdf"/>
</robot>
